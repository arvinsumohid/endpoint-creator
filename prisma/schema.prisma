generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String?
  password      String
  refreshToken  String?
  verified      Boolean    @default(false)
  emailVerified DateTime?
  endpoints     Endpoint[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Endpoint {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  path        String   @unique
  requestBody String?
  responseBody String?
  statusCode  Int?
  headers     String?
  queryParams String?
  pathParams  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
